# ============================================================
# MontirGo Admin — environment variables
# Salin file ini menjadi .env.local, jangan commit .env.local.
# ============================================================

# Supabase → Project Settings → API
# Nama NEXT_PUBLIC_* adalah konvensi Next.js. Panel ini juga membaca
# EXPO_PUBLIC_* sebagai fallback, jadi .env.local dari repo mobile
# (montirGo_app) bisa dipakai langsung tanpa rename.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WAJIB server-only. Jangan pernah diberi prefix NEXT_PUBLIC_.
# Key ini membypass RLS, jadi hanya boleh dipakai di Server Component /
# Server Action yang sudah melewati requireAdmin().
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsional: bootstrap admin pertama, pisahkan dengan koma.
# Email di sini otomatis dipromosikan menjadi profiles.role = 'admin'
# saat login pertama. Setelah itu role tetap tersimpan di database.
# Contoh: ADMIN_EMAILS=owner@montirgo.id,ops@montirgo.id
ADMIN_EMAILS=
